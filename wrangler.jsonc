{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "do-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "do-manager-db",
      "database_id": "d369a261-2b1a-4fb2-8810-770132810171",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "do-manager-backups" }
  ],

  "queues": {
    "producers": [
      { "binding": "DO_JOBS_QUEUE", "queue": "do-jobs" }
    ],
    "consumers": [
      {
        "queue": "do-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "do-jobs-dlq"
      },
      {
        "queue": "do-jobs-dlq",
        "max_batch_size": 10,
        "max_retries": 0
      }
    ]
  },

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "0 0 * * *"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
